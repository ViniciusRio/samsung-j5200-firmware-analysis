#!/bin/sh
# Read-only Binwalk wrapper for REA. Requires the locally built official image.
set -eu
project_dir=$(cd "$(dirname "$0")/.." && pwd)
exec docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges \
  --memory 2g --cpus 2 --read-only \
  --mount "type=bind,src=$project_dir,dst=$project_dir,readonly" \
  --mount "type=bind,src=/tmp,dst=/tmp" \
  samsung-j5200-binwalk:3.1.0 "$@"
